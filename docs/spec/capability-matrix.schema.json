{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/capability-matrix-1.0.0.json",
  "title": "HP LJ 1020 capability matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "matrixVersion", "scopeIdentities", "scenarios"],
  "properties": {
    "$schema": { "const": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/capability-matrix-1.0.0.json" },
    "schemaVersion": { "const": "1.0.0" },
    "matrixVersion": { "const": 1 },
    "scopeIdentities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "macOSVersion", "macOSBuild", "architecture"],
      "properties": {
        "kind": { "enum": ["hosted-ci", "local-host", "reference-mac", "supplementary-vm"] },
        "macOSVersion": { "type": "string", "minLength": 1 },
        "macOSBuild": { "type": "string", "minLength": 1 },
        "architecture": { "const": "arm64" }
      }
    },
    "printer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "vendorProduct", "serialSha256", "firmwareVersion"],
      "properties": {
        "model": { "const": "HP LaserJet 1020" },
        "vendorProduct": { "const": "03f0:2b17" },
        "serialSha256": { "$ref": "#/$defs/sha256" },
        "firmwareVersion": { "type": ["string", "null"] }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "outcome", "observedAt", "summary"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["passed", "failed"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "behavior",
        "milestone",
        "requirementIds",
        "provenance",
        "environment",
        "connectionPath",
        "sourceCommit",
        "dependencyLockSha256",
        "printer",
        "expectedResult",
        "observedResult",
        "executedAt",
        "durationSeconds",
        "evidence",
        "state",
        "affectedScopes",
        "invalidatedBy",
        "attempts",
        "intermittencyExplanation",
        "reliabilityRequirements",
        "requiresArtifactEvidence"
      ],
      "properties": {
        "scenarioId": { "type": "string", "pattern": "^SCN-[A-Z0-9-]+$" },
        "behavior": { "type": "string", "minLength": 1 },
        "milestone": { "enum": ["BASIC", "PERSONAL", "CAPABILITY", "PUBLIC"] },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "environment": { "oneOf": [{ "$ref": "#/$defs/environment" }, { "type": "null" }] },
        "connectionPath": { "enum": ["host-only", "ugreen-thunderbolt-4-dock", "direct-usb-a-to-usb-c", "both"] },
        "sourceCommit": { "oneOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }] },
        "dependencyLockSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "printer": { "oneOf": [{ "$ref": "#/$defs/printer" }, { "type": "null" }] },
        "expectedResult": { "type": "string", "minLength": 1 },
        "observedResult": { "type": ["string", "null"] },
        "executedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "state": { "enum": ["verified", "unverified", "unsupported", "deferred"] },
        "affectedScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" }
        },
        "invalidatedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
        "intermittencyExplanation": { "type": ["string", "null"] },
        "reliabilityRequirements": {
          "oneOf": [
            { "$ref": "#/$defs/reliability" },
            { "type": "null" }
          ]
        },
        "requiresArtifactEvidence": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
          "then": {
            "properties": {
              "environment": { "$ref": "#/$defs/environment" },
              "sourceCommit": { "$ref": "#/$defs/gitCommit" },
              "dependencyLockSha256": { "$ref": "#/$defs/sha256" },
              "observedResult": { "type": "string", "minLength": 1 },
              "executedAt": { "type": "string", "format": "date-time" },
              "durationSeconds": { "type": "number", "minimum": 0 },
              "evidence": { "minItems": 1 },
              "attempts": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": { "const": "verified" },
              "connectionPath": { "not": { "const": "host-only" } }
            },
            "required": ["state", "connectionPath"]
          },
          "then": { "properties": { "printer": { "$ref": "#/$defs/printer" } } }
        }
      ]
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticalTransitionPassesPerConnectionPath", "mixedDocumentSoakJobs", "maximumServiceRestartsDuringSoak", "lifecycleCycles"],
      "properties": {
        "criticalTransitionPassesPerConnectionPath": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ugreen-thunderbolt-4-dock", "direct-usb-a-to-usb-c"],
          "properties": {
            "ugreen-thunderbolt-4-dock": { "type": "integer", "minimum": 5 },
            "direct-usb-a-to-usb-c": { "type": "integer", "minimum": 5 }
          }
        },
        "mixedDocumentSoakJobs": { "type": "integer", "minimum": 20 },
        "maximumServiceRestartsDuringSoak": { "const": 0 },
        "lifecycleCycles": { "type": "integer", "minimum": 3 }
      }
    }
  }
}
