{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/diagnostic-bundle-inventory-1.0.0.json",
  "title": "HP LJ 1020 diagnostic bundle inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "inventoryVersion", "maximumBundleBytes", "entries", "prohibitedDataClasses"],
  "properties": {
    "$schema": { "const": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/diagnostic-bundle-inventory-1.0.0.json" },
    "schemaVersion": { "const": "1.0.0" },
    "inventoryVersion": { "const": "1.0.0" },
    "maximumBundleBytes": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "presence", "producer", "content", "maximumBytes", "privacyTransforms"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]*$" },
          "presence": { "enum": ["required", "optional"] },
          "producer": { "enum": ["bundle-generator", "status-command", "service-log-export", "configuration-export"] },
          "content": { "type": "string", "minLength": 1 },
          "maximumBytes": { "type": "integer", "minimum": 1 },
          "privacyTransforms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "prohibitedDataClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "document-content",
          "raster-payload",
          "zjstream-payload",
          "document-filename",
          "username",
          "credential",
          "firmware-content",
          "unrelated-system-data",
          "full-printer-serial"
        ]
      }
    }
  }
}
