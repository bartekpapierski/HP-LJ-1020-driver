{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/build-manifest-1.0.0.json",
  "title": "HP LJ 1020 build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "productVersion",
    "source",
    "toolchain",
    "configuration",
    "dependencyLock",
    "signingMode",
    "builtAt",
    "artifacts"
  ],
  "properties": {
    "$schema": { "const": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/build-manifest-1.0.0.json" },
    "schemaVersion": { "const": "1.0.0" },
    "productVersion": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "cleanTree", "specificationCommit"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitCommit" },
        "cleanTree": { "const": true },
        "specificationCommit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xcodeBuild", "compiler", "sdkBuild", "deploymentTarget", "architectures"],
      "properties": {
        "xcodeBuild": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "sdkBuild": { "type": "string", "minLength": 1 },
        "deploymentTarget": { "type": "string", "minLength": 1 },
        "architectures": {
          "type": "array",
          "const": ["arm64"]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "dependencies.lock.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generatedInputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/checksummedPath" },
      "default": []
    },
    "signingMode": { "enum": ["unsigned-development", "ad-hoc-hardened-runtime", "developer-id"] },
    "builtAt": { "type": "string", "format": "date-time" },
    "ciRun": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "runId", "commit"],
      "properties": {
        "provider": { "const": "github-actions" },
        "runId": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checksummedPath" }
    }
  },
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checksummedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
