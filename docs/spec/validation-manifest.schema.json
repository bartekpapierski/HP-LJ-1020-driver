{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/validation-manifest-1.0.0.json",
  "title": "HP LJ 1020 validation run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "runId",
    "sourceCommit",
    "specificationCommit",
    "dependencyLockSha256",
    "buildManifestSha256",
    "capabilityMatrixSha256",
    "environment",
    "printer",
    "scopeIdentities",
    "startedAt",
    "finishedAt",
    "result",
    "scenarioResults",
    "evidence",
    "supportClaims",
    "redacted",
    "sealed"
  ],
  "properties": {
    "$schema": { "const": "https://bartekpapierski.github.io/HP-LJ-1020-driver/schemas/validation-manifest-1.0.0.json" },
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "sourceCommit": { "$ref": "#/$defs/gitCommit" },
    "specificationCommit": { "$ref": "#/$defs/gitCommit" },
    "dependencyLockSha256": { "$ref": "#/$defs/sha256" },
    "buildManifestSha256": { "$ref": "#/$defs/sha256" },
    "capabilityMatrixSha256": { "$ref": "#/$defs/sha256" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "macOSVersion", "macOSBuild", "architecture", "connectionPaths"],
      "properties": {
        "kind": { "enum": ["hosted-ci", "local-host", "reference-mac", "supplementary-vm"] },
        "macOSVersion": { "type": "string", "minLength": 1 },
        "macOSBuild": { "type": "string", "minLength": 1 },
        "architecture": { "const": "arm64" },
        "connectionPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["host-only", "ugreen-thunderbolt-4-dock", "direct-usb-a-to-usb-c"] }
        }
      }
    },
    "printer": { "oneOf": [{ "$ref": "#/$defs/printer" }, { "type": "null" }] },
    "scopeIdentities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "result": { "enum": ["passed", "failed", "incomplete"] },
    "scenarioResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioResult" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/checksummedPath" } },
    "supportClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "statement"],
        "properties": {
          "scenarioId": { "$ref": "#/$defs/scenarioId" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "redacted": { "const": true },
    "sealed": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "passed" } }, "required": ["result"] },
      "then": {
        "properties": {
          "sealed": { "const": true },
          "scenarioResults": { "items": { "properties": { "state": { "const": "verified" } } } }
        }
      }
    },
    {
      "if": { "properties": { "supportClaims": { "minItems": 1 } }, "required": ["supportClaims"] },
      "then": { "properties": { "result": { "const": "passed" }, "sealed": { "const": true } } }
    }
  ],
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenarioId": { "type": "string", "pattern": "^SCN-[A-Z0-9-]+$" },
    "printer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "vendorProduct", "serial", "firmwareVersion"],
      "properties": {
        "model": { "const": "HP LaserJet 1020" },
        "vendorProduct": { "const": "03f0:2b17" },
        "serial": { "type": "string", "minLength": 1 },
        "firmwareVersion": { "type": ["string", "null"] }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "outcome", "observedAt", "summary"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["passed", "failed"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "requirementIds", "state", "summary", "observedAt", "evidenceSha256", "attempts", "intermittencyExplanation", "reliabilityObservations"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
        },
        "state": { "enum": ["verified", "unverified", "unsupported", "deferred"] },
        "summary": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "evidenceSha256": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
        "intermittencyExplanation": { "type": ["string", "null"] },
        "reliabilityObservations": {
          "oneOf": [
            { "$ref": "#/$defs/reliabilityObservations" },
            { "type": "null" }
          ]
        }
      }
    },
    "checksummedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind", "immutable", "result", "privacyChecked"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["sanitized-log", "measurement", "scan", "photograph", "summary", "manifest"] },
        "immutable": { "const": true },
        "result": { "enum": ["passed", "failed"] },
        "privacyChecked": { "const": true }
      }
    },
    "reliabilityObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticalTransitionPassesPerConnectionPath", "mixedDocumentSoakJobs", "serviceRestartsDuringSoak", "lifecycleCycles"],
      "properties": {
        "criticalTransitionPassesPerConnectionPath": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ugreen-thunderbolt-4-dock", "direct-usb-a-to-usb-c"],
          "properties": {
            "ugreen-thunderbolt-4-dock": { "type": "integer", "minimum": 0 },
            "direct-usb-a-to-usb-c": { "type": "integer", "minimum": 0 }
          }
        },
        "mixedDocumentSoakJobs": { "type": "integer", "minimum": 0 },
        "serviceRestartsDuringSoak": { "type": "integer", "minimum": 0 },
        "lifecycleCycles": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
