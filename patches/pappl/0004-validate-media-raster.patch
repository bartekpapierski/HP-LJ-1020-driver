 #include "pappl-private.h"
 
+
+// HP-LJ-1020-driver: never silently crop/pad or rescale a client raster.
+// The client composes orientation into pixels using the physical feed axes.
+static bool hplj_raster_matches(const cups_page_header_t *input,
+                                const cups_page_header_t *output)
+{
+  return input->cupsWidth == output->cupsWidth &&
+         input->cupsHeight == output->cupsHeight &&
+         input->HWResolution[0] == output->HWResolution[0] &&
+         input->HWResolution[1] == output->HWResolution[1] &&
+         (input->MediaPosition == 0 || input->MediaPosition == output->MediaPosition);
+}
 
