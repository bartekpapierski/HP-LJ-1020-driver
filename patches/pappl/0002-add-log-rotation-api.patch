+//
+// 'papplSystemRotateLog()' - Rotate the system log immediately.
+//
+
+bool
+papplSystemRotateLog(
+    pappl_system_t *system,              // I - System
+    time_t         not_after)            // I - Latest log creation time
+{
+  bool rotated;                          // Did the log rotate?
+  struct stat loginfo;                   // Log file information
+
+
+  if (!system || system->log_is_syslog || !strcmp(system->log_file, "-"))
+    return (false);
+
+  pthread_mutex_lock(&system->log_mutex);
+  rotated = false;
+  if (!fstat(system->log_fd, &loginfo))
+  {
+#if defined(__APPLE__)
+    time_t log_time = loginfo.st_birthtimespec.tv_sec;
+#else
+    time_t log_time = loginfo.st_mtime;
+#endif // __APPLE__
+    if (log_time <= not_after)
+      rotated = rotate_log_no_lock(system, true);
+  }
+  pthread_mutex_unlock(&system->log_mutex);
+
+  return (rotated);
+}
+
