<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bartekpapierski.hplj1020.launch-boundary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/HP-LJ-1020/Prototype/bin/hplj1020-pappl</string>
    <string>server</string>
    <string>-o</string>
    <string>server-hostname=localhost</string>
    <string>-o</string>
    <string>listen-hostname=localhost</string>
    <string>-o</string>
    <string>server-port=8631</string>
    <string>-o</string>
    <string>server-options=no-web-interface,no-tls</string>
    <string>-o</string>
    <string>spool-directory="/Library/Application Support/HP-LJ-1020/State/Spool"</string>
    <string>-o</string>
    <string>log-file=/Library/Logs/HP-LJ-1020/launch-boundary.log</string>
    <string>-o</string>
    <string>log-level=info</string>
  </array>
  <key>UserName</key>
  <string>_hplj1020</string>
  <key>GroupName</key>
  <string>_hplj1020</string>
  <key>WorkingDirectory</key>
  <string>/Library/Application Support/HP-LJ-1020/State</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Library/Application Support/HP-LJ-1020/State/Home</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/HP-LJ-1020/daemon.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/HP-LJ-1020/daemon.stderr.log</string>
</dict>
</plist>
